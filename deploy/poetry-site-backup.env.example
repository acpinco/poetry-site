# Copy this file to /etc/poetry-site-backup.env on the production server.
# It is server configuration, not a Git-tracked secret file.

# The root cron job uses Docker, then runs rclone as this account so it can use
# that account's Google Drive OAuth and rclone crypt configuration.
BACKUP_OWNER=remote

# Archives are retained locally for the same 31-day period as Google Drive.
BACKUP_DIRECTORY=/home/remote/backups/poetry-site
RETENTION_DAYS=31

# This must be an rclone crypt remote, not the unencrypted Google Drive remote.
RCLONE_REMOTE=poetry-site-google-crypt:postgresql
RCLONE_CONFIG=/home/remote/.config/rclone/rclone.conf
