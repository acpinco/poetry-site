# Copy this file to /etc/poetry-site-backup.env on the production server.
# It is server configuration, not a Git-tracked secret file.

# The root cron job uses Docker, then assigns local archives to this account so
# they are easy to inspect without using root.
BACKUP_OWNER=remote

# Local-only archives are retained for 31 days. This protects against accidental
# database changes, but not loss of the server itself.
BACKUP_DIRECTORY=/home/remote/backups/poetry-site
RETENTION_DAYS=31
