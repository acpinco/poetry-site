:80 {
    encode zstd gzip

    # Security headers for every response. Spring Security already sends most of
    # these for backend pages; Caddy serves the React app's files itself, so set
    # them here once. "defer" applies them after the backend responds, replacing
    # its copies instead of duplicating them.
    #
    # The Content-Security-Policy is deliberately narrow: it blocks framing,
    # plugins, <base> hijacking, and stray form posts. It does not restrict
    # scripts or styles, because Turnstile, Google Fonts, and anything Cloudflare
    # injects would all need allow-listing first.
    header {
        defer
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }

    handle /api/* {
        header X-Robots-Tag "noindex, nofollow"
        reverse_proxy app:8080 {
            # Cloudflare Tunnel (and the prior Tailscale Funnel) terminate public
            # HTTPS before proxying to this HTTP-only listener.
            header_up X-Forwarded-Proto https
        }
    }

    handle /swagger-ui* {
        header X-Robots-Tag "noindex, nofollow"
        reverse_proxy app:8080 {
            header_up X-Forwarded-Proto https
        }
    }

    handle /v3/* {
        header X-Robots-Tag "noindex, nofollow"
        reverse_proxy app:8080 {
            header_up X-Forwarded-Proto https
        }
    }

    handle /poems/* {
        reverse_proxy app:8080
    }

    handle /poets/* {
        reverse_proxy app:8080
    }

    # This is a stable, server-rendered daily feature page. It must reach the
    # backend rather than falling through to the React application's index.html.
    handle /poem-of-the-day {
        reverse_proxy app:8080 {
            header_up X-Forwarded-Proto https
        }
    }

    handle /sitemap.xml {
        reverse_proxy app:8080
    }

    handle /robots.txt {
        reverse_proxy app:8080
    }

    # The public root is server-rendered so search engines receive meaningful
    # content without needing to execute the React application.
    handle / {
        reverse_proxy app:8080 {
            header_up X-Forwarded-Proto https
        }
    }

    # Vite fingerprints bundles on every build. Never cache an SPA document or
    # it can reference a bundle hash that was removed by the next deployment.
    @spa path /home /home/* /sign-in /sign-in/* /account/setup /account/setup/* /my-poems /my-poems/* /contact /contact/* /admin /admin/*
    handle @spa {
        header Cache-Control "no-store"
        root * /srv
        try_files {path} /index.html
        file_server
    }

    # Assets must never fall through to index.html: a missing JavaScript file
    # should be a real 404, not HTML with an invalid module MIME type.
    handle /assets/* {
        root * /srv
        file_server
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
