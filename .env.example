POSTGRES_DB=poetry_site
POSTGRES_USER=poetry_app
POSTGRES_PASSWORD=replace-with-a-long-local-password
SPRING_PROFILES_ACTIVE=local
SWAGGER_ENABLED=true
FRONTEND_BASE_URL=http://localhost:5173
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_CONTACT_EMAIL=support@example.com
CONTACT_EMAIL=contact@example.com
# Cloudflare Turnstile test keys that always pass. Use real keys from the Cloudflare dashboard in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
