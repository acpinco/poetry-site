# PostgreSQL's first startup creates this database and application user.
POSTGRES_DB=poetry_site
POSTGRES_USER=poetry_app
POSTGRES_PASSWORD=replace-with-a-long-unique-production-password

# This must be the externally visible HTTPS address used in magic-link emails.
MAGIC_LINK_BASE_URL=https://thinkordrinkpoetry.tail0e35ab.ts.net
SECURE_SESSION_COOKIE=true

# Temporary: remove or change to false after public Swagger testing is complete.
SWAGGER_ENABLED=true

# Fill these in after selecting an SMTP provider. They are not needed for startup,
# but magic-link email cannot work until they are real values.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
# Use a domain verified with the email provider; do not use a personal Gmail address.
MAIL_FROM=Think or Drink Poetry <noreply@your-verified-domain.example>
